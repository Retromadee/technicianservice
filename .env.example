# ============================================================
# HomeFix Pro — Environment Variables for Docker
# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit it.
# ============================================================

# ---- PostgreSQL ----
DB_PASSWORD=homefix_secure_pass

# ---- JWT ----
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY
JWT_EXPIRATION_MS=86400000

# ---- AI Keys ----
OPENAI_API_KEY=sk-REPLACE_ME
GOOGLE_VISION_API_KEY=REPLACE_ME

# ---- CORS ----
# Add your production frontend URL (Vercel domain) here
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app
